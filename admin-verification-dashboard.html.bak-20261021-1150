<script src="js/storage.js"></script>
<script src="js/config.js"></script>
<script src="js/supabase-client.js"></script>
<script src="js/storage-adapter.js"></script>
<script src="js/auth-bridge.js"></script>

<script>
(function () {
  'use strict';

  const $ = (s) => document.querySelector(s);
  const $$ = (s) => document.querySelectorAll(s);
  const faNum = (n) => String(n).replace(/\d/g, d => '۰۱۲۳۴۵۶۷۸۹'[d]);

  // ═══════════════════════════════════
  // State
  // ═══════════════════════════════════
  const state = {
    user: null,
    cases: [],
    filtered: [],
    currentTab: 'all',
    searchQuery: '',
    action: null
  };

  // ═══════════════════════════════════
  // Auth check
  // ═══════════════════════════════════
  function checkAuth() {
    try {
      const raw = localStorage.getItem('wamPayCurrentUser');
      if (!raw) {
        console.warn('⚠️ کاربر لاگین نیست');
        window.location.href = 'login.html';
        return false;
      }
      const user = JSON.parse(raw);
      
      const allowedRoles = ['super_admin', 'admin', 'verification_admin', 'deputy_admin'];
      if (!allowedRoles.includes(user.role)) {
        console.warn('⚠️ دسترسی غیرمجاز:', user.role);
        window.location.href = 'login.html';
        return false;
      }

      state.user = user;
      return true;
    } catch (e) {
      console.error('❌ checkAuth:', e);
      window.location.href = 'login.html';
      return false;
    }
  }

  // ═══════════════════════════════════
  // Load data from Supabase (v1.1 — بهینه‌شده)
  // ═══════════════════════════════════
  async function loadData() {
    console.log('🔄 [Verification] بارگذاری داده‌ها...');

    if (window.WAM_SB && window.WAM_SB.client) {
      try {
        console.log('☁️ [Verification] خواندن از Supabase...');

        // 🆕 فقط فیلدهای ضروری + بدون order برای جلوگیری از timeout
        const { data, error } = await window.WAM_SB.client
          .from('applications')
          .select('id, application_number, user_id, loan_type, loan_bank, loan_amount, status, current_step, total_steps, personal_info, financial_info, created_at, updated_at')
          .limit(100);

        if (!error && data) {
          // 🆕 مرتب‌سازی سمت کلاینت (به جای سرور)
          const sorted = data.slice().sort((a, b) => {
            const da = new Date(a.created_at || 0).getTime();
            const db = new Date(b.created_at || 0).getTime();
            return db - da;
          });

          state.cases = sorted.map(a => ({
            id: a.id,
            caseNumber: a.application_number,
            userId: a.user_id,
            loanType: a.loan_type,
            loanBank: a.loan_bank,
            loanAmount: a.loan_amount,
            status: a.status,
            currentStep: a.current_step,
            personalInfo: a.personal_info || {},
            financialInfo: a.financial_info || {},
            documents: {},  // 🆕 برای دمو خالی
            createdAt: a.created_at,
            updatedAt: a.updated_at
          }));

          console.log(`✅ [Verification] ${state.cases.length} پرونده از Supabase`);
        } else if (error) {
          console.warn('⚠️ خطا در Supabase:', error.message);
          state.cases = [];
        }
      } catch (e) {
        console.warn('⚠️ خطا:', e.message);
        state.cases = [];
      }
    } else {
      console.warn('⚠️ WAM_SB نیست');
      state.cases = [];
    }

    applyFilters();
    updateStats();
  }

  // ═══════════════════════════════════
  // Filters
  // ═══════════════════════════════════
  function applyFilters() {
    let list = state.cases.slice();

    if (state.currentTab !== 'all') {
      list = list.filter(c => c.status === state.currentTab);
    }

    if (state.searchQuery) {
      const q = state.searchQuery.toLowerCase();
      list = list.filter(c => {
        const hay = [
          c.caseNumber,
          c.personalInfo.firstName,
          c.personalInfo.lastName,
          c.personalInfo.mobile,
          c.personalInfo.nationalId,
          c.loanType
        ].join(' ').toLowerCase();
        return hay.includes(q);
      });
    }

    state.filtered = list;
    render();
  }

  // ═══════════════════════════════════
  // Stats
  // ═══════════════════════════════════
  function updateStats() {
    const all = state.cases;
    const pending = all.filter(c => c.status === 'submitted' || c.status === 'pending').length;
    const reviewing = all.filter(c => c.status === 'under_review').length;
    const approved = all.filter(c => c.status === 'approved' || c.status === 'completed').length;
    const rejected = all.filter(c => c.status === 'rejected').length;

    $('#statPending').textContent = faNum(pending);
    $('#statReviewing').textContent = faNum(reviewing);
    $('#statApproved').textContent = faNum(approved);
    $('#statRejected').textContent = faNum(rejected);

    $('#cntAll').textContent = faNum(all.length);
    $('#cntPending').textContent = faNum(pending);
    $('#cntReviewing').textContent = faNum(reviewing);
    $('#cntApproved').textContent = faNum(approved);
    $('#cntRejected').textContent = faNum(rejected);
  }

  // ═══════════════════════════════════
  // Render
  // ═══════════════════════════════════
  function render() {
    const list = state.filtered;
    const box = $('#casesList');
    const empty = $('#emptyState');

    if (list.length === 0) {
      box.innerHTML = '';
      empty.style.display = 'block';
      $('#emptyText').textContent = state.currentTab === 'all'
        ? 'هیچ پرونده‌ای برای بررسی وجود ندارد.'
        : `هیچ پرونده‌ای در وضعیت "${getTabLabel(state.currentTab)}" نیست.`;
      return;
    }

    empty.style.display = 'none';

    box.innerHTML = list.map(c => renderCard(c)).join('');

    box.querySelectorAll('[data-action]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const action = btn.dataset.action;
        const id = btn.dataset.id;
        const item = state.cases.find(x => x.id === id);
        if (!item) return;

        if (action === 'approve') openModal('approve', item);
        else if (action === 'reject') openModal('reject', item);
        else if (action === 'review') changeStatus(item, 'under_review');
        else if (action === 'view') viewDetails(item);
      });
    });
  }

  function getTabLabel(tab) {
    const labels = {
      all: 'همه',
      pending: 'در انتظار',
      under_review: 'در بررسی',
      approved: 'تأیید شده',
      rejected: 'رد شده'
    };
    return labels[tab] || tab;
  }

  function renderCard(c) {
    const status = c.status || 'pending';
    const statusLabel = {
      draft: '📝 پیش‌نویس',
      submitted: '⏳ در انتظار',
      pending: '⏳ در انتظار',
      under_review: '🔍 در بررسی',
      approved: '✅ تأیید شده',
      completed: '🎉 تکمیل شده',
      rejected: '❌ رد شده'
    }[status] || '⏳ در انتظار';

    const statusClass = (status === 'approved' || status === 'completed') ? 'approved'
                     : status === 'rejected' ? 'rejected'
                     : status === 'under_review' ? 'under_review'
                     : 'pending';

    const fullName = `${c.personalInfo.firstName || ''} ${c.personalInfo.lastName || ''}`.trim() || 'نامشخص';
    const mobile = c.personalInfo.mobile || '—';
    const nationalId = c.personalInfo.nationalId || '—';
    const loanAmount = (c.loanAmount || 0).toLocaleString('fa-IR');
    const loanType = {
      resalat: 'قرض‌الحسنه رسالت',
      mehr: 'قرض‌الحسنه مهر',
      sepah: 'سپه',
      melli: 'ملی',
      housing: 'مسکن',
      personal: 'شخصی',
      car: 'خودرو',
      business: 'کسب‌وکار',
      education: 'تحصیلی',
      qarz_hasaneh: 'قرض‌الحسنه'
    }[c.loanType] || c.loanType || '—';

    const date = c.createdAt ? new Date(c.createdAt).toLocaleDateString('fa-IR') : '—';

    const docs = c.documents || {};
    const docKeys = Object.keys(docs);
    const docsHtml = docKeys.length > 0
      ? docKeys.slice(0, 6).map(k => `
          <div class="wam-verify__doc" title="${k}">
            <span class="wam-verify__doc-icon">📎</span>
            <span>${k.slice(0, 15)}</span>
          </div>
        `).join('')
      : '<div style="color:var(--wam-text-muted);font-size:12px;padding:6px">📭 مدرکی بارگذاری نشده</div>';

    let actions = '';
    if (status === 'submitted' || status === 'pending' || status === 'draft') {
      actions = `
        <button type="button" class="wam-verify__btn wam-verify__btn--approve" data-action="approve" data-id="${c.id}">✅ تأیید</button>
        <button type="button" class="wam-verify__btn wam-verify__btn--reject" data-action="reject" data-id="${c.id}">❌ رد</button>
        <button type="button" class="wam-verify__btn wam-verify__btn--ghost" data-action="review" data-id="${c.id}">🔍 شروع بررسی</button>
      `;
    } else if (status === 'under_review') {
      actions = `
        <button type="button" class="wam-verify__btn wam-verify__btn--approve" data-action="approve" data-id="${c.id}">✅ تأیید</button>
        <button type="button" class="wam-verify__btn wam-verify__btn--reject" data-action="reject" data-id="${c.id}">❌ رد</button>
        <button type="button" class="wam-verify__btn wam-verify__btn--ghost" data-action="view" data-id="${c.id}">👁 جزئیات</button>
      `;
    } else {
      actions = `
        <button type="button" class="wam-verify__btn wam-verify__btn--ghost" data-action="view" data-id="${c.id}">👁 جزئیات</button>
      `;
    }

    return `
      <div class="wam-verify__card" data-status="${statusClass}">
        <div class="wam-verify__card-head">
          <div>
            <h4 class="wam-verify__card-title">
              📁 ${c.caseNumber || 'بدون شماره'}
            </h4>
            <div class="wam-verify__card-meta">
              <span>👤 ${fullName}</span>
              <span>📱 ${mobile}</span>
              <span>🆔 ${nationalId}</span>
            </div>
          </div>
          <span class="wam-verify__badge wam-verify__badge--${statusClass}">${statusLabel}</span>
        </div>

        <div class="wam-verify__card-meta">
          <span>💰 ${loanAmount} تومان</span>
          <span>🏦 ${loanType}</span>
          <span>📅 ${date}</span>
        </div>

        <div class="wam-verify__docs">
          ${docsHtml}
        </div>

        <div class="wam-verify__actions">
          ${actions}
        </div>
      </div>
    `;
  }

  // ═══════════════════════════════════
  // Modal
  // ═══════════════════════════════════
  function openModal(type, item) {
    state.action = { type, item };
    $('#modalTitle').textContent = type === 'approve' ? '✅ تأیید پرونده' : '❌ رد پرونده';
    $('#reasonLabel').textContent = type === 'approve' ? 'یادداشت (اختیاری)' : 'دلیل رد (اجباری)';
    $('#confirmBtn').className = 'wam-verify__btn wam-verify__btn--' + (type === 'approve' ? 'approve' : 'reject');
    $('#confirmBtn').textContent = type === 'approve' ? '✅ تأیید نهایی' : '❌ رد نهایی';
    $('#reasonInput').value = '';
    $('#decisionModal').classList.add('is-open');
    setTimeout(() => $('#reasonInput').focus(), 150);
  }

  function closeModal() {
    $('#decisionModal').classList.remove('is-open');
    state.action = null;
  }

  async function confirmAction() {
    if (!state.action) return;
    const { type, item } = state.action;
    const reason = $('#reasonInput').value.trim();

    if (type === 'reject' && !reason) {
      alert('لطفاً دلیل رد را وارد کنید.');
      return;
    }

    const newStatus = type === 'approve' ? 'approved' : 'rejected';

    if (window.WAM_SB && window.WAM_SB.client) {
      try {
        const { error } = await window.WAM_SB.client
          .from('applications')
          .update({
            status: newStatus,
            updated_at: new Date().toISOString()
          })
          .eq('id', item.id);

        if (error) {
          console.warn('⚠️ خطا در آپدیت Supabase:', error.message);
        } else {
          console.log(`✅ پرونده ${item.caseNumber} → ${newStatus}`);
        }
      } catch (e) {
        console.warn('⚠️ خطا:', e.message);
      }
    }

    const localItem = state.cases.find(c => c.id === item.id);
    if (localItem) {
      localItem.status = newStatus;
      localItem.updatedAt = new Date().toISOString();
    }

    closeModal();
    applyFilters();
    updateStats();

    showToast(type === 'approve' ? '✅ پرونده تأیید شد' : '❌ پرونده رد شد', type === 'approve' ? 'success' : 'error');
  }

  async function changeStatus(item, newStatus) {
    if (window.WAM_SB && window.WAM_SB.client) {
      try {
        await window.WAM_SB.client
          .from('applications')
          .update({ status: newStatus, updated_at: new Date().toISOString() })
          .eq('id', item.id);
      } catch (e) {
        console.warn('⚠️ خطا:', e.message);
      }
    }
    const localItem = state.cases.find(c => c.id === item.id);
    if (localItem) localItem.status = newStatus;
    applyFilters();
    updateStats();
    showToast('🔍 وضعیت به «در بررسی» تغییر کرد', 'info');
  }

  function viewDetails(item) {
    const fullName = `${item.personalInfo.firstName || ''} ${item.personalInfo.lastName || ''}`.trim();
    alert(
      '📁 جزئیات پرونده\n\n' +
      'شماره: ' + (item.caseNumber || '—') + '\n' +
      'متقاضی: ' + (fullName || '—') + '\n' +
      'موبایل: ' + (item.personalInfo.mobile || '—') + '\n' +
      'کد ملی: ' + (item.personalInfo.nationalId || '—') + '\n' +
      'مبلغ وام: ' + (item.loanAmount || 0).toLocaleString('fa-IR') + ' تومان\n' +
      'نوع وام: ' + (item.loanType || '—') + '\n' +
      'وضعیت: ' + (item.status || '—')
    );
  }

  // ═══════════════════════════════════
  // Toast
  // ═══════════════════════════════════
  function showToast(msg, type = 'info') {
    const t = document.createElement('div');
    t.style.cssText = `
      position: fixed;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%) translateY(120%);
      background: ${type === 'success' ? '#1e8e4a' : type === 'error' ? '#c0392b' : '#0b3b23'};
      color: #fff;
      padding: 14px 24px;
      border-radius: 10px;
      font-size: 14px;
      font-weight: 600;
      z-index: 9999;
      box-shadow: 0 16px 48px rgba(0,0,0,0.2);
      transition: transform 0.35s;
    `;
    t.textContent = msg;
    document.body.appendChild(t);
    setTimeout(() => t.style.transform = 'translateX(-50%) translateY(0)', 50);
    setTimeout(() => {
      t.style.transform = 'translateX(-50%) translateY(120%)';
      setTimeout(() => t.remove(), 400);
    }, 3000);
  }

  // ═══════════════════════════════════
  // User & Theme
  // ═══════════════════════════════════
  function applyUser() {
    if (!state.user) return;
    const name = state.user.name || state.user.username || 'کارشناس';
    $('#userName').textContent = name;
    $('#userAvatar').textContent = name.charAt(0).toUpperCase();
  }

  function initTheme() {
    const saved = localStorage.getItem('wamPayTheme');
    if (saved === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
    const btn = $('#themeBtn');
    if (btn) {
      btn.textContent = saved === 'dark' ? '☀️' : '🌙';
      btn.addEventListener('click', () => {
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        if (isDark) {
          document.documentElement.removeAttribute('data-theme');
          localStorage.setItem('wamPayTheme', 'light');
          btn.textContent = '🌙';
        } else {
          document.documentElement.setAttribute('data-theme', 'dark');
          localStorage.setItem('wamPayTheme', 'dark');
          btn.textContent = '☀️';
        }
      });
    }
  }

  // ═══════════════════════════════════
  // Events
  // ═══════════════════════════════════
  function attachEvents() {
    $$('.wam-verify__tab').forEach(tab => {
      tab.addEventListener('click', () => {
        $$('.wam-verify__tab').forEach(t => t.classList.remove('is-active'));
        tab.classList.add('is-active');
        state.currentTab = tab.dataset.tab;
        applyFilters();
      });
    });

    const searchInput = $('#searchInput');
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        state.searchQuery = e.target.value.trim();
        applyFilters();
      });
    }

    $('#refreshBtn')?.addEventListener('click', async () => {
      const btn = $('#refreshBtn');
      btn.textContent = '⏳';
      await loadData();
      btn.textContent = '🔄';
      showToast('✅ به‌روزرسانی شد', 'success');
    });

    $('#logoutBtn')?.addEventListener('click', () => {
      if (!confirm('از حساب خارج می‌شوید؟')) return;
      localStorage.removeItem('wamPayCurrentUser');
      localStorage.removeItem('wamPayToken');
      window.location.href = 'login.html';
    });

    $('#modalClose')?.addEventListener('click', closeModal);
    $('#cancelBtn')?.addEventListener('click', closeModal);
    $('#confirmBtn')?.addEventListener('click', confirmAction);
    $('#decisionModal')?.addEventListener('click', (e) => {
      if (e.target === $('#decisionModal')) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });
  }

  // ═══════════════════════════════════
  // Init
  // ═══════════════════════════════════
  async function init() {
    if (!checkAuth()) return;
    applyUser();
    initTheme();
    attachEvents();
    await loadData();

    console.log('%c🔍 WAM PAY — Verification Dashboard v1.1', 'color:#0b3b23;font-weight:bold;font-size:14px;');
    console.log('%c👤 کاربر:', 'color:#0b3b23;font-weight:bold;', state.user.name);
    console.log('%c📁 پرونده‌ها:', 'color:#0b3b23;font-weight:bold;', state.cases.length);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

})();
</script>

</body>
</html>